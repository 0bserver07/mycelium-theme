---
/**
 * LayoutToggle Component
 *
 * Toggle buttons for switching between grid and list views
 * Saves preference to localStorage
 */

export interface Props {
  defaultLayout?: 'grid' | 'list';
}

const { defaultLayout = 'grid' } = Astro.props;
---

<div class="layout-toggle flex items-center gap-1 bg-primary-100 dark:bg-primary-800 rounded-lg p-1" data-default={defaultLayout}>
  <button
    type="button"
    data-layout="grid"
    class="layout-btn p-2 rounded-md transition-colors"
    aria-label="Grid view"
  >
    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z"/>
    </svg>
  </button>
  <button
    type="button"
    data-layout="list"
    class="layout-btn p-2 rounded-md transition-colors"
    aria-label="List view"
  >
    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
    </svg>
  </button>
</div>

<script>
  function initLayoutToggle() {
    const toggle = document.querySelector('.layout-toggle');
    if (!toggle) return;

    const defaultLayout = toggle.getAttribute('data-default') || 'grid';
    const gridBtn = toggle.querySelector('[data-layout="grid"]');
    const listBtn = toggle.querySelector('[data-layout="list"]');
    const gridView = document.querySelector('[data-view="grid"]');
    const listView = document.querySelector('[data-view="list"]');
    const container = document.querySelector('[data-layout-container]');

    if (!gridBtn || !listBtn || !gridView || !listView) return;

    // Get saved preference or use default
    const saved = localStorage.getItem('posts-layout') || defaultLayout;

    function setLayout(layout: string) {
      // Update buttons
      if (layout === 'grid') {
        gridBtn.classList.add('bg-white', 'dark:bg-primary-700', 'text-accent-600', 'dark:text-accent-400', 'shadow-sm');
        gridBtn.classList.remove('text-primary-500', 'dark:text-primary-400');
        listBtn.classList.remove('bg-white', 'dark:bg-primary-700', 'text-accent-600', 'dark:text-accent-400', 'shadow-sm');
        listBtn.classList.add('text-primary-500', 'dark:text-primary-400');
      } else {
        listBtn.classList.add('bg-white', 'dark:bg-primary-700', 'text-accent-600', 'dark:text-accent-400', 'shadow-sm');
        listBtn.classList.remove('text-primary-500', 'dark:text-primary-400');
        gridBtn.classList.remove('bg-white', 'dark:bg-primary-700', 'text-accent-600', 'dark:text-accent-400', 'shadow-sm');
        gridBtn.classList.add('text-primary-500', 'dark:text-primary-400');
      }

      // Update views
      if (layout === 'grid') {
        gridView.classList.remove('hidden');
        listView.classList.add('hidden');
      } else {
        listView.classList.remove('hidden');
        gridView.classList.add('hidden');
      }

      // Update container width
      if (container) {
        if (layout === 'list') {
          container.classList.remove('max-w-5xl');
          container.classList.add('max-w-3xl');
        } else {
          container.classList.remove('max-w-3xl');
          container.classList.add('max-w-5xl');
        }
      }

      // Save preference
      localStorage.setItem('posts-layout', layout);
    }

    // Set initial layout
    setLayout(saved);

    // Add click handlers
    gridBtn.addEventListener('click', () => setLayout('grid'));
    listBtn.addEventListener('click', () => setLayout('list'));
  }

  // Run on load and on navigation
  initLayoutToggle();
  document.addEventListener('astro:after-swap', initLayoutToggle);
</script>
