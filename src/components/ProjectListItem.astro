---
/**
 * ProjectListItem Component
 *
 * List item display for project previews with:
 * - Title
 * - Description
 * - Status
 * - Technologies
 * - Links
 */

import type { CollectionEntry } from 'astro:content';

export interface Props {
  project: CollectionEntry<'projects'>;
  featured?: boolean;
}

const { project, featured = false } = Astro.props;
const { title, description, status, technologies, repo, url } = project.data;
---

<article class:list={[
  "py-6 border-b border-gray-100 dark:border-gray-800 last:border-b-0 group",
  featured && "bg-primary-50/50 dark:bg-primary-900/10 -mx-4 px-4 rounded-lg border-none mb-4"
]}>
  <a href={`/projects/${project.id}/`} class="block">
    <!-- Header: Title and Status -->
    <div class="flex items-start justify-between mb-2">
      <h3 class:list={[
        "font-semibold text-gray-900 dark:text-gray-100 group-hover:text-primary-600 dark:group-hover:text-primary-400 transition-colors",
        featured ? "text-xl" : "text-lg"
      ]}>
        {title}
        {featured && (
          <span class="ml-2 px-2 py-0.5 text-xs font-medium bg-primary-100 dark:bg-primary-900 text-primary-700 dark:text-primary-300 rounded">
            Featured
          </span>
        )}
      </h3>
      <span class="text-sm text-gray-500 dark:text-gray-400 whitespace-nowrap ml-4">
        {status}
      </span>
    </div>

    <!-- Description -->
    <p class="text-gray-600 dark:text-gray-400 mb-3">
      {description}
    </p>
  </a>

  <!-- Footer: Technologies and Links -->
  <div class="flex items-center justify-between">
    {technologies && technologies.length > 0 && (
      <div class="flex flex-wrap gap-2">
        {technologies.map((tech: string) => (
          <span class="px-2 py-1 text-xs bg-gray-100 dark:bg-gray-700 text-gray-700 dark:text-gray-300 rounded">
            {tech}
          </span>
        ))}
      </div>
    )}

    <div class="flex items-center gap-3 ml-4">
      {repo && (
        <a
          href={repo}
          target="_blank"
          rel="noopener noreferrer"
          class="text-sm text-gray-500 hover:text-primary-600 dark:text-gray-400 dark:hover:text-primary-400"
          onclick="event.stopPropagation()"
        >
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
            <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
          </svg>
        </a>
      )}
      {url && (
        <a
          href={url}
          target="_blank"
          rel="noopener noreferrer"
          class="text-sm text-gray-500 hover:text-primary-600 dark:text-gray-400 dark:hover:text-primary-400"
          onclick="event.stopPropagation()"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
          </svg>
        </a>
      )}
    </div>
  </div>
</article>
