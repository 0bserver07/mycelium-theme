---
/**
 * LinkedMentions Component
 *
 * Displays backlinks - other posts that link to the current post
 */

import type { Post } from '../types';
import { getCollection } from 'astro:content';
import { findBacklinks } from '../utils/backlinks';
import { siteConfig } from '../config';

export interface Props {
  currentSlug: string;
}

const { currentSlug } = Astro.props;

// Get all posts
const allPosts = await getCollection('posts', ({ data }) => {
  return import.meta.env.PROD ? !data.draft : true;
});

// Find backlinks
const backlinks = findBacklinks(allPosts, currentSlug);
---

{siteConfig.features.backlinks && (
  <aside class="mt-12 pt-8 border-t border-primary-200 dark:border-primary-800">
    <h2 class="text-lg font-semibold text-primary-900 dark:text-primary-100 mb-4 flex items-center gap-2">
      <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/>
        <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/>
      </svg>
      Linked Mentions
      {backlinks.length > 0 && (
        <span class="text-sm font-normal text-primary-500">({backlinks.length})</span>
      )}
    </h2>

    {backlinks.length > 0 ? (
      <div class="space-y-4">
        {backlinks.map((mention) => (
          <a
            href={`/posts/${mention.slug}/`}
            class="block p-4 rounded-lg bg-primary-100/50 dark:bg-primary-800/50 hover:bg-primary-100 dark:hover:bg-primary-800 transition-colors group"
          >
            <div class="font-medium text-primary-900 dark:text-primary-100 group-hover:text-accent-600 dark:group-hover:text-accent-400 mb-1">
              {mention.title}
            </div>
            <p class="text-sm text-primary-600 dark:text-primary-400 line-clamp-2">
              {mention.excerpt}
            </p>
          </a>
        ))}
      </div>
    ) : (
      <p class="text-primary-500 text-sm">
        No other notes link to this one yet. Connect your thoughts by linking from other notes using <code class="text-xs bg-primary-100 dark:bg-primary-800 px-1 py-0.5 rounded-sm">[[{currentSlug}]]</code>
      </p>
    )}
  </aside>
)}
