---
/**
 * CommandPalette Component
 *
 * Global search and quick actions panel (Ctrl+K)
 */

import { getCollection } from 'astro:content';
import { siteConfig } from '../config';

// Get all searchable content
const posts = await getCollection('posts', ({ data }) => {
  return import.meta.env.PROD ? !data.draft : true;
});

const pages = await getCollection('pages', ({ data }) => {
  return import.meta.env.PROD ? !data.draft : true;
});

// Build search index
const searchIndex = [
  ...posts.map((post) => ({
    title: post.data.title,
    description: post.data.description || '',
    url: `/posts/${post.id}/`,
    type: 'post' as const,
    tags: post.data.tags || [],
  })),
  ...pages.map((page) => ({
    title: page.data.title,
    description: page.data.description || '',
    url: `/${page.id}/`,
    type: 'page' as const,
    tags: [],
  })),
];

const searchData = JSON.stringify(searchIndex);
---

{siteConfig.features.commandPalette && (
  <div
    id="command-palette"
    class="hidden fixed inset-0 z-50"
    role="dialog"
    aria-modal="true"
    aria-label="Search"
  >
    <!-- Backdrop -->
    <div id="command-palette-backdrop" class="absolute inset-0 bg-black/50 backdrop-blur-xs"></div>

    <!-- Panel -->
    <div class="relative flex items-start justify-center pt-[15vh] px-4">
      <div class="w-full max-w-xl bg-primary-50 dark:bg-primary-900 rounded-xl shadow-2xl border border-primary-200 dark:border-primary-700 overflow-hidden animate-scale-in">
        <!-- Search Input -->
        <div class="flex items-center border-b border-primary-200 dark:border-primary-700">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="w-5 h-5 ml-4 text-primary-500"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
          >
            <circle cx="11" cy="11" r="8"></circle>
            <path d="m21 21-4.3-4.3"></path>
          </svg>
          <input
            id="command-palette-input"
            type="text"
            class="w-full px-4 py-4 bg-transparent text-primary-900 dark:text-primary-100 placeholder-primary-500 focus:outline-hidden"
            placeholder="Search notes, pages, and more..."
            autocomplete="off"
          />
          <kbd class="hidden sm:flex items-center px-2 py-1 mr-4 text-xs font-mono text-primary-500 bg-primary-100 dark:bg-primary-800 rounded-sm">
            ESC
          </kbd>
        </div>

        <!-- Results -->
        <div id="command-palette-results" class="max-h-80 overflow-y-auto p-2">
          <!-- Quick Actions (shown when empty) -->
          <div id="command-palette-quick-actions">
            <div class="px-3 py-2 text-xs font-medium text-primary-500 uppercase">Quick Actions</div>
            <button
              class="command-palette-item w-full flex items-center gap-3 px-3 py-2 rounded-lg hover:bg-primary-100 dark:hover:bg-primary-800 text-left"
              data-action="toggle-theme"
            >
              <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-primary-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="12" cy="12" r="5"/>
                <path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"/>
              </svg>
              <span class="text-primary-900 dark:text-primary-100">Toggle dark mode</span>
            </button>
            <a
              href="/posts/"
              class="command-palette-item w-full flex items-center gap-3 px-3 py-2 rounded-lg hover:bg-primary-100 dark:hover:bg-primary-800"
            >
              <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-primary-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M12 2v6m0 0a4 4 0 100 8 4 4 0 000-8z"/>
                <path d="M12 22v-6"/>
              </svg>
              <span class="text-primary-900 dark:text-primary-100">Browse all notes</span>
            </a>
          </div>

          <!-- Search Results (hidden initially) -->
          <div id="command-palette-search-results" class="hidden"></div>
        </div>
      </div>
    </div>
  </div>
)}

<script define:vars={{ searchData }}>
  // Import Fuse.js dynamically
  let Fuse;
  let fuse;
  const searchIndex = JSON.parse(searchData);

  async function initSearch() {
    if (!Fuse) {
      const module = await import('fuse.js');
      Fuse = module.default;
      fuse = new Fuse(searchIndex, {
        keys: ['title', 'description', 'tags'],
        threshold: 0.3,
        includeScore: true,
      });
    }
  }

  function initCommandPalette() {
    const palette = document.getElementById('command-palette');
    const input = document.getElementById('command-palette-input');
    const backdrop = document.getElementById('command-palette-backdrop');
    const quickActions = document.getElementById('command-palette-quick-actions');
    const searchResults = document.getElementById('command-palette-search-results');

    if (!palette || !input) return;

    // Keyboard shortcut to open
    document.addEventListener('keydown', async (e) => {
      if ((e.ctrlKey || e.metaKey) && e.key === 'k') {
        e.preventDefault();
        await initSearch();
        openPalette();
      }

      if (e.key === 'Escape' && !palette.classList.contains('hidden')) {
        closePalette();
      }
    });

    // Close on backdrop click
    backdrop?.addEventListener('click', closePalette);

    // Search on input
    input.addEventListener('input', (e) => {
      const query = (e.target as HTMLInputElement).value.trim();
      if (query.length === 0) {
        showQuickActions();
      } else {
        performSearch(query);
      }
    });

    // Handle quick action clicks
    document.querySelectorAll('[data-action="toggle-theme"]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const isDark = document.documentElement.classList.toggle('dark');
        localStorage.setItem('theme', isDark ? 'dark' : 'light');
        closePalette();
      });
    });

    function openPalette() {
      palette.classList.remove('hidden');
      input.focus();
      input.value = '';
      showQuickActions();
      document.body.style.overflow = 'hidden';
    }

    function closePalette() {
      palette.classList.add('hidden');
      document.body.style.overflow = '';
    }

    function showQuickActions() {
      if (quickActions) quickActions.classList.remove('hidden');
      if (searchResults) searchResults.classList.add('hidden');
    }

    function performSearch(query: string) {
      if (!fuse || !searchResults || !quickActions) return;

      const results = fuse.search(query).slice(0, 10);

      if (results.length === 0) {
        searchResults.innerHTML = `
          <div class="px-3 py-8 text-center text-primary-500">
            No results found for "${query}"
          </div>
        `;
      } else {
        searchResults.innerHTML = results
          .map(
            ({ item }) => `
          <a href="${item.url}" class="command-palette-item flex items-center gap-3 px-3 py-2 rounded-lg hover:bg-primary-100 dark:hover:bg-primary-800">
            <span class="text-xs px-1.5 py-0.5 rounded-sm bg-primary-100 dark:bg-primary-800 text-primary-600 dark:text-primary-400">
              ${item.type}
            </span>
            <div class="flex-1 min-w-0">
              <div class="text-primary-900 dark:text-primary-100 truncate">${item.title}</div>
              ${item.description ? `<div class="text-xs text-primary-500 truncate">${item.description}</div>` : ''}
            </div>
          </a>
        `
          )
          .join('');
      }

      quickActions.classList.add('hidden');
      searchResults.classList.remove('hidden');
    }
  }

  // Initialize
  document.addEventListener('DOMContentLoaded', initCommandPalette);
  document.addEventListener('astro:page-load', initCommandPalette);
</script>
