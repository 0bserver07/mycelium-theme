---
/**
 * PostListItem Component
 *
 * Blog-style list item for post previews with:
 * - Title
 * - Description
 * - Growth status
 * - Dates
 * - Tags
 * - Reading time
 */

import type { Post } from '../types';
import GrowthIndicator from './GrowthIndicator.astro';
import Tags from './Tags.astro';
import { siteConfig } from '../config';

export interface Props {
  post: Post;
}

const { post } = Astro.props;
const { title, description, growth, planted, tags } = post.data;

const plantedDate = planted.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

// Estimate reading time (rough: 200 words per minute)
const content = post.body || '';
const wordCount = content.split(/\s+/).length;
const readingTime = Math.max(1, Math.ceil(wordCount / 200));
---

<article class="py-8 border-b border-primary-100 dark:border-primary-800 last:border-b-0 group">
  <a href={`/posts/${post.id}/`} class="block">
    <!-- Meta line: date, growth, reading time -->
    <div class="flex items-center gap-4 mb-3 text-sm text-primary-500 dark:text-primary-500">
      <time>{plantedDate}</time>
      {siteConfig.garden.showGrowthStatus && (
        <>
          <span class="text-primary-300 dark:text-primary-700">·</span>
          <GrowthIndicator status={growth} size="sm" showLabel={true} />
        </>
      )}
      {siteConfig.posts.showReadingTime && (
        <>
          <span class="text-primary-300 dark:text-primary-700">·</span>
          <span>{readingTime} min read</span>
        </>
      )}
    </div>

    <!-- Title -->
    <h2 class="text-2xl font-semibold text-primary-900 dark:text-primary-100 group-hover:text-accent-600 dark:group-hover:text-accent-400 transition-colors mb-3">
      {title}
    </h2>

    <!-- Description -->
    {description && (
      <p class="text-primary-600 dark:text-primary-400 leading-relaxed mb-4">
        {description}
      </p>
    )}
  </a>

  <!-- Tags -->
  {siteConfig.posts.showTags && tags && tags.length > 0 && (
    <Tags tags={tags} />
  )}
</article>
