---
/**
 * LocalGraph Component
 *
 * D3.js force-directed graph visualization showing:
 * - Current post as center node
 * - Connected posts as surrounding nodes
 * - Links between posts
 */

import type { Post } from '../types';
import { getCollection } from 'astro:content';
import { extractAllLinks } from '../utils/backlinks';
import { siteConfig } from '../config';

export interface Props {
  currentSlug?: string;
}

const { currentSlug } = Astro.props;

// Get all posts for graph data
const allPosts = await getCollection('posts', ({ data }) => {
  return import.meta.env.PROD ? !data.draft : true;
});

// Build graph data
interface GraphNode {
  id: string;
  title: string;
  connections: number;
}

interface GraphConnection {
  source: string;
  target: string;
}

const nodes: GraphNode[] = [];
const connections: GraphConnection[] = [];
const nodeMap = new Map<string, GraphNode>();

// Create nodes for all posts
for (const post of allPosts) {
  const node: GraphNode = {
    id: post.id,
    title: post.data.title,
    connections: 0,
  };
  nodes.push(node);
  nodeMap.set(post.id, node);
}

// Create connections based on links
for (const post of allPosts) {
  const body = post.body || '';
  const links = extractAllLinks(body);

  for (const link of links) {
    // Find target post by slug
    const targetPost = allPosts.find((p) => p.id === link.slug);
    if (targetPost && targetPost.id !== post.id) {
      // Check if connection already exists
      const exists = connections.some(
        (c) =>
          (c.source === post.id && c.target === targetPost.id) ||
          (c.source === targetPost.id && c.target === post.id)
      );

      if (!exists) {
        connections.push({
          source: post.id,
          target: targetPost.id,
        });

        // Increment connection counts
        const sourceNode = nodeMap.get(post.id);
        const targetNode = nodeMap.get(targetPost.id);
        if (sourceNode) sourceNode.connections++;
        if (targetNode) targetNode.connections++;
      }
    }
  }
}

// Filter to only show nodes connected to current post (for local graph)
let filteredNodes = nodes;
let filteredConnections = connections;

if (currentSlug) {
  const connectedIds = new Set([currentSlug]);

  // Find directly connected nodes
  for (const conn of connections) {
    if (conn.source === currentSlug) {
      connectedIds.add(conn.target);
    } else if (conn.target === currentSlug) {
      connectedIds.add(conn.source);
    }
  }

  filteredNodes = nodes.filter((n) => connectedIds.has(n.id));
  filteredConnections = connections.filter(
    (c) => connectedIds.has(c.source) && connectedIds.has(c.target)
  );
}

// Check if there are any connections to show
const hasConnections = filteredNodes.length > 1;

const graphData = JSON.stringify({
  nodes: filteredNodes,
  connections: filteredConnections,
  currentSlug,
});
---

{hasConnections && siteConfig.features.localGraph && (
  <div
    id="local-graph-container"
    class="relative w-full bg-primary-50 dark:bg-primary-900 rounded-xl border border-primary-200 dark:border-primary-800 overflow-hidden"
    style="height: 280px;"
    data-graph={graphData}
  >
    <div id="local-graph-content" class="w-full h-full"></div>
  </div>
)}

<script>
  import * as d3 from 'd3';

  interface GraphNode extends d3.SimulationNodeDatum {
    id: string;
    title: string;
    connections: number;
  }

  interface GraphConnection {
    source: string | GraphNode;
    target: string | GraphNode;
  }

  interface GraphData {
    nodes: GraphNode[];
    connections: GraphConnection[];
    currentSlug?: string;
  }

  function initLocalGraph() {
    const container = document.getElementById('local-graph-container');
    const content = document.getElementById('local-graph-content');

    if (!container || !content) return;

    const dataAttr = container.dataset.graph;
    if (!dataAttr) return;

    const data: GraphData = JSON.parse(dataAttr);
    if (data.nodes.length === 0) return;

    // Clear previous content
    content.innerHTML = '';

    const width = content.clientWidth;
    const height = content.clientHeight;

    // Create SVG
    const svg = d3
      .select(content)
      .append('svg')
      .attr('width', width)
      .attr('height', height)
      .attr('viewBox', [-width / 2, -height / 2, width, height]);

    // Process links
    const links = data.connections.map((d) => ({ ...d }));
    const nodes = data.nodes.map((d) => ({ ...d }));

    // Create force simulation
    const simulation = d3
      .forceSimulation(nodes)
      .force(
        'link',
        d3
          .forceLink(links)
          .id((d: any) => d.id)
          .distance(60)
      )
      .force('charge', d3.forceManyBody().strength(-100))
      .force('center', d3.forceCenter(0, 0))
      .force('collision', d3.forceCollide().radius(20));

    // Create links
    const link = svg
      .append('g')
      .attr('class', 'links')
      .selectAll('line')
      .data(links)
      .join('line')
      .attr('stroke', 'currentColor')
      .attr('stroke-opacity', 0.3)
      .attr('stroke-width', 1);

    // Create node groups
    const node = svg
      .append('g')
      .attr('class', 'nodes')
      .selectAll('g')
      .data(nodes)
      .join('g')
      .attr('cursor', 'pointer')
      .call(
        d3
          .drag<SVGGElement, GraphNode>()
          .on('start', (event, d) => {
            if (!event.active) simulation.alphaTarget(0.3).restart();
            d.fx = d.x;
            d.fy = d.y;
          })
          .on('drag', (event, d) => {
            d.fx = event.x;
            d.fy = event.y;
          })
          .on('end', (event, d) => {
            if (!event.active) simulation.alphaTarget(0);
            d.fx = null;
            d.fy = null;
          }) as any
      );

    // Add circles
    node
      .append('circle')
      .attr('r', (d) => (d.id === data.currentSlug ? 8 : 5 + Math.min(d.connections, 5)))
      .attr('fill', (d) =>
        d.id === data.currentSlug
          ? 'rgb(var(--color-accent-500))'
          : 'rgb(var(--color-primary-400))'
      )
      .attr('stroke', 'rgb(var(--color-primary-100))')
      .attr('stroke-width', 1);

    // Add labels
    node
      .append('text')
      .text((d) => d.title)
      .attr('x', 0)
      .attr('y', (d) => (d.id === data.currentSlug ? 20 : 16))
      .attr('text-anchor', 'middle')
      .attr('fill', 'currentColor')
      .attr('font-size', '10px')
      .attr('opacity', 0.8);

    // Click handler for navigation
    node.on('click', (event, d) => {
      if (d.id !== data.currentSlug) {
        window.location.href = `/posts/${d.id}/`;
      }
    });

    // Hover effects
    node
      .on('mouseover', function () {
        d3.select(this).select('circle').attr('stroke-width', 2);
        d3.select(this).select('text').attr('opacity', 1);
      })
      .on('mouseout', function () {
        d3.select(this).select('circle').attr('stroke-width', 1);
        d3.select(this).select('text').attr('opacity', 0.8);
      });

    // Update positions on tick
    simulation.on('tick', () => {
      link
        .attr('x1', (d: any) => d.source.x)
        .attr('y1', (d: any) => d.source.y)
        .attr('x2', (d: any) => d.target.x)
        .attr('y2', (d: any) => d.target.y);

      node.attr('transform', (d: any) => `translate(${d.x},${d.y})`);
    });
  }

  // Initialize on load
  document.addEventListener('DOMContentLoaded', initLocalGraph);
  document.addEventListener('astro:page-load', initLocalGraph);
</script>
