---
/**
 * Posts Listing Page
 *
 * Lists all garden posts/notes
 * Supports grid/list layout and pages/infinite pagination via config
 */

import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import PostCard from '../../components/PostCard.astro';
import PostListItem from '../../components/PostListItem.astro';
import Pagination from '../../components/Pagination.astro';
import InfiniteScroll from '../../components/InfiniteScroll.astro';
import { getCollection } from 'astro:content';
import { siteConfig } from '../../config';

// Get all posts, filter drafts in production
const allPosts = await getCollection('posts', ({ data }) => {
  return import.meta.env.PROD ? !data.draft : true;
});

// Sort by planted date, newest first
const allPostsSorted = allPosts.sort(
  (a, b) => b.data.planted.valueOf() - a.data.planted.valueOf()
);

// Config
const { postsPerPage, layout, pagination } = siteConfig.posts;
const isInfinite = pagination === 'infinite';
const isList = layout === 'list';

// For infinite scroll, show all posts; for pages, show first page only
const posts = isInfinite ? allPostsSorted : allPostsSorted.slice(0, postsPerPage);
const totalPages = Math.ceil(allPostsSorted.length / postsPerPage);

// Get unique tags from all posts
const allTags = [...new Set(allPostsSorted.flatMap((post) => post.data.tags || []))].sort();
---

<BaseLayout title="Garden" description="All notes in the digital garden">
  <Header slot="header" />

  <div class:list={["mx-auto px-4 py-8 sm:py-12", isList ? "max-w-3xl" : "max-w-5xl"]}>
    <!-- Header -->
    <div class="mb-8">
      <h1 class="text-3xl font-bold text-primary-900 dark:text-primary-100 mb-2">
        The Garden
      </h1>
      <p class="text-primary-600 dark:text-primary-400">
        {allPostsSorted.length} notes growing in this garden
      </p>
    </div>

    <!-- Tags Filter (if there are tags) -->
    {allTags.length > 0 && (
      <div class="mb-8 flex flex-wrap gap-2">
        <span class="text-sm text-primary-600 dark:text-primary-400 mr-2">Filter by tag:</span>
        {allTags.map((tag) => (
          <a
            href={`/posts/tag/${tag}/`}
            class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-primary-100 text-primary-700 dark:bg-primary-800 dark:text-primary-300 hover:bg-accent-100 dark:hover:bg-accent-900/30 hover:text-accent-700 dark:hover:text-accent-300 transition-colors"
          >
            #{tag}
          </a>
        ))}
      </div>
    )}

    <!-- Posts -->
    {posts.length > 0 ? (
      isInfinite ? (
        <!-- Infinite Scroll Mode -->
        <InfiniteScroll initialCount={postsPerPage} batchSize={postsPerPage}>
          {isList ? (
            <!-- List Layout -->
            <div class="divide-y divide-primary-100 dark:divide-primary-800">
              {posts.map((post) => (
                <PostListItem post={post} />
              ))}
            </div>
          ) : (
            <!-- Grid Layout -->
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
              {posts.map((post) => (
                <PostCard post={post} />
              ))}
            </div>
          )}
        </InfiniteScroll>
      ) : (
        <!-- Pages Mode -->
        <>
          {isList ? (
            <!-- List Layout -->
            <div class="divide-y divide-primary-100 dark:divide-primary-800 mb-12">
              {posts.map((post) => (
                <PostListItem post={post} />
              ))}
            </div>
          ) : (
            <!-- Grid Layout -->
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mb-12">
              {posts.map((post) => (
                <PostCard post={post} />
              ))}
            </div>
          )}

          {/* Pagination */}
          {totalPages > 1 && (
            <Pagination
              currentPage={1}
              totalPages={totalPages}
              baseUrl="/posts/page/"
              firstPageUrl="/posts/"
            />
          )}
        </>
      )
    ) : (
      <div class="text-center py-12">
        <p class="text-primary-600 dark:text-primary-400">
          No notes have been planted yet. Start adding content to see them here!
        </p>
      </div>
    )}
  </div>

  <Footer slot="footer" />
</BaseLayout>
