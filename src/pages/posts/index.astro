---
/**
 * Posts Listing Page
 *
 * Lists all garden posts/notes
 * Supports grid/list layout toggle and pages/infinite pagination via config
 */

import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import PostCard from '../../components/PostCard.astro';
import PostListItem from '../../components/PostListItem.astro';
import LayoutToggle from '../../components/LayoutToggle.astro';
import Pagination from '../../components/Pagination.astro';
import InfiniteScroll from '../../components/InfiniteScroll.astro';
import { getCollection } from 'astro:content';
import { siteConfig } from '../../config';
import { calculateAllGrowth, getEffectiveGrowth } from '../../utils/growth';

// Get all posts, filter drafts in production
const allPosts = await getCollection('posts', ({ data }) => {
  return import.meta.env.PROD ? !data.draft : true;
});

// Sort by planted date, newest first
const allPostsSorted = allPosts.sort(
  (a, b) => b.data.planted.valueOf() - a.data.planted.valueOf()
);

// Calculate growth based on connections (backlinks + series)
const growthResults = calculateAllGrowth(allPostsSorted);
const autoGrowth = siteConfig.garden.autoGrowth;

// Create a map of postId -> effective growth status
const effectiveGrowthMap = new Map<string, string>();
for (const [postId, result] of growthResults) {
  effectiveGrowthMap.set(postId, getEffectiveGrowth(result, autoGrowth));
}

// Helper to get effective growth for a post
const getPostGrowth = (post: typeof allPostsSorted[0]) =>
  effectiveGrowthMap.get(post.id) || post.data.growth;

// Group by effective growth status for tabs
const seedlings = allPostsSorted.filter(p => getPostGrowth(p) === 'seedling');
const budding = allPostsSorted.filter(p => getPostGrowth(p) === 'budding');
const evergreen = allPostsSorted.filter(p => getPostGrowth(p) === 'evergreen');

// Config
const { postsPerPage, layout, pagination } = siteConfig.posts;
const isInfinite = pagination === 'infinite';

// For infinite scroll, show all posts; for pages, show first page only
const posts = isInfinite ? allPostsSorted : allPostsSorted.slice(0, postsPerPage);
const totalPages = Math.ceil(allPostsSorted.length / postsPerPage);

// Get unique tags from all posts
const allTags = [...new Set(allPostsSorted.flatMap((post) => post.data.tags || []))].sort();
---

<BaseLayout title="Garden" description="All notes in the digital garden">
  <Header slot="header" />

  <div data-layout-container class:list={["mx-auto px-4 py-8 sm:py-12", layout === 'list' ? "max-w-3xl" : "max-w-5xl"]}>
    <!-- Header with Layout Toggle -->
    <div class="flex items-start justify-between mb-8">
      <div>
        <h1 class="text-3xl font-bold text-primary-900 dark:text-primary-100 mb-2">
          The Garden
        </h1>
        <p class="text-primary-600 dark:text-primary-400">
          {allPostsSorted.length} notes growing in this garden
        </p>
      </div>
      <LayoutToggle defaultLayout={layout} storageKey="posts-layout" />
    </div>

    <!-- Growth Tabs (Primary Filter) -->
    <div class="mb-4">
      <div class="flex flex-wrap gap-2">
        <button
          data-growth="all"
          class="growth-tab inline-flex items-center gap-2 px-4 py-2 rounded-lg font-medium transition-colors bg-accent-500 text-white"
        >
          All
          <span class="text-xs bg-white/20 px-1.5 py-0.5 rounded-sm">{allPostsSorted.length}</span>
        </button>
        <button
          data-growth="seedling"
          class="growth-tab inline-flex items-center gap-2 px-4 py-2 rounded-lg font-medium transition-colors bg-primary-100 dark:bg-primary-800 text-primary-700 dark:text-primary-300"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M7 20h10"/><path d="M12 20v-6"/><path d="M9 10a3 3 0 0 1 6 0"/><path d="M12 10V7"/><path d="M9 7a3 3 0 0 1 6 0"/>
          </svg>
          Seedling
          <span class="text-xs bg-green-200 dark:bg-green-900 text-green-800 dark:text-green-200 px-1.5 py-0.5 rounded-sm">{seedlings.length}</span>
        </button>
        <button
          data-growth="budding"
          class="growth-tab inline-flex items-center gap-2 px-4 py-2 rounded-lg font-medium transition-colors bg-primary-100 dark:bg-primary-800 text-primary-700 dark:text-primary-300"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M7 20h10"/><path d="M12 20v-8"/><path d="M12 12c-2-2-4-2.5-4-5a4 4 0 0 1 8 0c0 2.5-2 3-4 5"/>
          </svg>
          Budding
          <span class="text-xs bg-amber-200 dark:bg-amber-900 text-amber-800 dark:text-amber-200 px-1.5 py-0.5 rounded-sm">{budding.length}</span>
        </button>
        <button
          data-growth="evergreen"
          class="growth-tab inline-flex items-center gap-2 px-4 py-2 rounded-lg font-medium transition-colors bg-primary-100 dark:bg-primary-800 text-primary-700 dark:text-primary-300"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M12 22v-7"/><path d="M9 22h6"/><path d="M12 15l-4-4 2-1-3-3 3-1-2-3h8l-2 3 3 1-3 3 2 1z"/>
          </svg>
          Evergreen
          <span class="text-xs bg-emerald-200 dark:bg-emerald-900 text-emerald-800 dark:text-emerald-200 px-1.5 py-0.5 rounded-sm">{evergreen.length}</span>
        </button>
      </div>
    </div>

    <!-- Tag Combobox (Secondary Filter) -->
    {allTags.length > 0 && (
      <div class="mb-8">
        <!-- Selected Tags (chips) -->
        <div id="selected-tags" class="flex flex-wrap gap-2 mb-2 empty:mb-0"></div>

        <!-- Search Input -->
        <div class="relative">
          <input
            type="text"
            id="tag-search"
            placeholder="Search tags..."
            autocomplete="off"
            class="w-full max-w-xs bg-primary-50 dark:bg-primary-800 border border-primary-200 dark:border-primary-700 text-primary-700 dark:text-primary-300 rounded-lg px-4 py-2 text-sm focus:ring-2 focus:ring-accent-500 focus:border-accent-500"
          />
          <svg class="absolute right-3 top-1/2 -translate-y-1/2 w-4 h-4 text-primary-400 pointer-events-none" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35"/>
          </svg>

          <!-- Dropdown -->
          <div id="tag-dropdown" class="hidden absolute z-10 mt-1 w-full max-w-xs max-h-48 overflow-y-auto bg-white dark:bg-primary-800 border border-primary-200 dark:border-primary-700 rounded-lg shadow-lg">
            {allTags.map((tag) => (
              <button
                type="button"
                data-tag={tag}
                class="tag-option w-full text-left px-4 py-2 text-sm text-primary-700 dark:text-primary-300 hover:bg-primary-100 dark:hover:bg-primary-700 transition-colors"
              >
                #{tag}
              </button>
            ))}
            <div id="no-tags-match" class="hidden px-4 py-2 text-sm text-primary-500 dark:text-primary-400">
              No tags match
            </div>
          </div>
        </div>
      </div>
    )}

    <!-- Posts -->
    {allPostsSorted.length > 0 ? (
      <>
        <div id="posts-grid" data-view="grid" class:list={["grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mb-12", layout === 'list' && "hidden"]}>
          {allPostsSorted.map((post) => (
            <div class="post-card h-full" data-growth={getPostGrowth(post)} data-tags={JSON.stringify(post.data.tags || [])}>
              <PostCard post={post} effectiveGrowth={getPostGrowth(post)} />
            </div>
          ))}
        </div>
        <div id="posts-list" data-view="list" class:list={["divide-y divide-primary-100 dark:divide-primary-800 mb-12", layout === 'grid' && "hidden"]}>
          {allPostsSorted.map((post) => (
            <div class="post-card" data-growth={getPostGrowth(post)} data-tags={JSON.stringify(post.data.tags || [])}>
              <PostListItem post={post} effectiveGrowth={getPostGrowth(post)} />
            </div>
          ))}
        </div>
      </>
    ) : (
      <div class="text-center py-12">
        <p class="text-primary-600 dark:text-primary-400">
          No notes have been planted yet. Start adding content to see them here!
        </p>
      </div>
    )}

    <!-- Empty State (when filters match nothing) -->
    <div id="empty-state" class="hidden text-center py-12">
      <p class="text-primary-600 dark:text-primary-400">
        No notes match your filters.
      </p>
    </div>
  </div>

  <Footer slot="footer" />
</BaseLayout>

<script>
  function initFilters() {
    const tabs = document.querySelectorAll('.growth-tab');
    const postCards = document.querySelectorAll('.post-card');
    const postsGrid = document.getElementById('posts-grid');
    const postsList = document.getElementById('posts-list');
    const emptyState = document.getElementById('empty-state');

    // Tag combobox elements
    const tagSearch = document.getElementById('tag-search') as HTMLInputElement;
    const tagDropdown = document.getElementById('tag-dropdown');
    const tagOptions = document.querySelectorAll('.tag-option');
    const selectedTagsContainer = document.getElementById('selected-tags');
    const noTagsMatch = document.getElementById('no-tags-match');

    let activeGrowth = 'all';
    let selectedTags: string[] = [];

    // Check URL params on load
    const urlParams = new URLSearchParams(window.location.search);
    const growthParam = urlParams.get('growth');
    const tagsParam = urlParams.get('tags');

    if (growthParam && ['seedling', 'budding', 'evergreen'].includes(growthParam)) {
      activeGrowth = growthParam;
    }
    if (tagsParam) {
      selectedTags = tagsParam.split(',').filter(t => t);
    }

    function updateTabStyles() {
      tabs.forEach((tab) => {
        const growth = tab.getAttribute('data-growth');
        const isActive = growth === activeGrowth;

        tab.className = 'growth-tab inline-flex items-center gap-2 px-4 py-2 rounded-lg font-medium transition-colors';

        if (isActive) {
          if (growth === 'all') {
            tab.classList.add('bg-accent-500', 'text-white');
          } else if (growth === 'seedling') {
            tab.classList.add('bg-green-500', 'text-white');
          } else if (growth === 'budding') {
            tab.classList.add('bg-amber-500', 'text-white');
          } else if (growth === 'evergreen') {
            tab.classList.add('bg-emerald-500', 'text-white');
          }
        } else {
          tab.classList.add('bg-primary-100', 'dark:bg-primary-800', 'text-primary-700', 'dark:text-primary-300');
        }
      });
    }

    function renderSelectedTags() {
      if (!selectedTagsContainer) return;
      selectedTagsContainer.innerHTML = selectedTags.map(tag => `
        <span class="inline-flex items-center gap-1 px-2 py-1 rounded-full text-xs font-medium bg-accent-100 dark:bg-accent-900/30 text-accent-700 dark:text-accent-300">
          #${tag}
          <button type="button" data-remove-tag="${tag}" class="hover:text-accent-900 dark:hover:text-accent-100">
            <svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M18 6L6 18M6 6l12 12"/>
            </svg>
          </button>
        </span>
      `).join('');

      // Add remove handlers
      selectedTagsContainer.querySelectorAll('[data-remove-tag]').forEach(btn => {
        btn.addEventListener('click', () => {
          const tag = btn.getAttribute('data-remove-tag');
          if (tag) {
            selectedTags = selectedTags.filter(t => t !== tag);
            renderSelectedTags();
            updateTagOptions();
            filterPosts();
          }
        });
      });
    }

    function updateTagOptions() {
      tagOptions.forEach(opt => {
        const tag = opt.getAttribute('data-tag');
        if (tag && selectedTags.includes(tag)) {
          opt.classList.add('bg-accent-100', 'dark:bg-accent-900/30');
        } else {
          opt.classList.remove('bg-accent-100', 'dark:bg-accent-900/30');
        }
      });
    }

    function filterDropdown(query: string) {
      const q = query.toLowerCase();
      let visibleCount = 0;

      tagOptions.forEach(opt => {
        const tag = opt.getAttribute('data-tag') || '';
        if (tag.toLowerCase().includes(q)) {
          (opt as HTMLElement).style.display = '';
          visibleCount++;
        } else {
          (opt as HTMLElement).style.display = 'none';
        }
      });

      if (noTagsMatch) {
        noTagsMatch.classList.toggle('hidden', visibleCount > 0);
      }
    }

    function filterPosts() {
      let visibleCount = 0;

      postCards.forEach((card) => {
        const cardGrowth = card.getAttribute('data-growth');
        const cardTags: string[] = JSON.parse(card.getAttribute('data-tags') || '[]');

        const matchesGrowth = activeGrowth === 'all' || cardGrowth === activeGrowth;
        const matchesTags = selectedTags.length === 0 || selectedTags.some(t => cardTags.includes(t));

        if (matchesGrowth && matchesTags) {
          (card as HTMLElement).style.display = '';
          visibleCount++;
        } else {
          (card as HTMLElement).style.display = 'none';
        }
      });

      if (emptyState && postsGrid && postsList) {
        if (visibleCount === 0) {
          emptyState.classList.remove('hidden');
          postsGrid.classList.add('hidden');
          postsList.classList.add('hidden');
        } else {
          emptyState.classList.add('hidden');
          const currentLayout = localStorage.getItem('posts-layout') || 'grid';
          if (currentLayout === 'grid') {
            postsGrid.classList.remove('hidden');
            postsList.classList.add('hidden');
          } else {
            postsList.classList.remove('hidden');
            postsGrid.classList.add('hidden');
          }
        }
      }

      // Update URL
      const params = new URLSearchParams();
      if (activeGrowth !== 'all') params.set('growth', activeGrowth);
      if (selectedTags.length > 0) params.set('tags', selectedTags.join(','));
      const newUrl = params.toString() ? `?${params.toString()}` : window.location.pathname;
      window.history.replaceState({}, '', newUrl);
    }

    // Tab click handlers
    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        activeGrowth = tab.getAttribute('data-growth') || 'all';
        updateTabStyles();
        filterPosts();
      });
    });

    // Tag search handlers
    if (tagSearch && tagDropdown) {
      tagSearch.addEventListener('focus', () => {
        tagDropdown.classList.remove('hidden');
      });

      tagSearch.addEventListener('input', () => {
        filterDropdown(tagSearch.value);
      });

      // Close dropdown when clicking outside
      document.addEventListener('click', (e) => {
        if (!tagSearch.contains(e.target as Node) && !tagDropdown.contains(e.target as Node)) {
          tagDropdown.classList.add('hidden');
        }
      });
    }

    // Tag option click handlers
    tagOptions.forEach(opt => {
      opt.addEventListener('click', () => {
        const tag = opt.getAttribute('data-tag');
        if (tag) {
          if (selectedTags.includes(tag)) {
            selectedTags = selectedTags.filter(t => t !== tag);
          } else {
            selectedTags.push(tag);
          }
          renderSelectedTags();
          updateTagOptions();
          filterPosts();
          if (tagSearch) tagSearch.value = '';
          filterDropdown('');
        }
      });
    });

    // Initialize
    updateTabStyles();
    renderSelectedTags();
    updateTagOptions();
    filterPosts();
  }

  document.addEventListener('DOMContentLoaded', initFilters);
  document.addEventListener('astro:page-load', initFilters);
</script>
