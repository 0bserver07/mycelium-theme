---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const docs = await getCollection('docs');

// Group by category
const categories = docs.reduce((acc, doc) => {
  const category = doc.data.category || 'General';
  if (!acc[category]) acc[category] = [];
  acc[category].push(doc);
  return acc;
}, {} as Record<string, typeof docs>);

// Sort each category by order
Object.keys(categories).forEach(cat => {
  categories[cat].sort((a, b) => (a.data.order || 999) - (b.data.order || 999));
});
---

<BaseLayout title="Documentation" description="Guides and documentation">
  <Header slot="header" />
  <div class="container mx-auto px-4 py-12 max-w-4xl">
    <header class="mb-12">
      <h1 class="text-4xl font-bold text-gray-900 dark:text-gray-100 mb-4">Documentation</h1>
      <p class="text-xl text-gray-600 dark:text-gray-400">
        Guides, tutorials, and reference documentation
      </p>
    </header>

    {Object.entries(categories).length > 0 ? (
      <div class="space-y-12">
        {Object.entries(categories).map(([category, categoryDocs]) => (
          <section>
            <h2 class="text-2xl font-bold text-gray-900 dark:text-gray-100 mb-4 capitalize">
              {category}
            </h2>
            <div class="space-y-2">
              {categoryDocs.map((doc, index) => (
                <a
                  href={`/docs/${doc.id}`}
                  class="group flex items-center gap-4 p-4 bg-white dark:bg-gray-800 rounded-lg border border-gray-200 dark:border-gray-700 hover:border-primary-400 dark:hover:border-primary-600 transition-colors"
                >
                  <span class="flex-shrink-0 w-8 h-8 flex items-center justify-center bg-primary-100 dark:bg-primary-900 text-primary-700 dark:text-primary-300 rounded-full text-sm font-medium">
                    {index + 1}
                  </span>
                  <div>
                    <h3 class="font-semibold text-gray-900 dark:text-gray-100 group-hover:text-primary-600 dark:group-hover:text-primary-400">
                      {doc.data.title}
                    </h3>
                    {doc.data.description && (
                      <p class="text-sm text-gray-600 dark:text-gray-400">
                        {doc.data.description}
                      </p>
                    )}
                  </div>
                </a>
              ))}
            </div>
          </section>
        ))}
      </div>
    ) : (
      <div class="text-center py-12">
        <p class="text-gray-500 dark:text-gray-400">No documentation yet.</p>
      </div>
    )}
  </div>
  <Footer slot="footer" />
</BaseLayout>
