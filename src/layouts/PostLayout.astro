---
/**
 * PostLayout - Layout for garden posts/notes
 *
 * Displays:
 * - Post title and metadata
 * - Growth status indicator
 * - Tags
 * - Table of contents (optional)
 * - Content
 * - Local graph
 * - Backlinks (linked mentions)
 */

import BaseLayout from './BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import GrowthIndicator from '../components/GrowthIndicator.astro';
import Tags from '../components/Tags.astro';
import LocalGraph from '../components/LocalGraph.astro';
import LinkedMentions from '../components/LinkedMentions.astro';
import TableOfContents from '../components/TableOfContents.astro';
import Giscus from '../components/Giscus.astro';
import LinkPreview from '../components/LinkPreview.astro';
import ImageLightbox from '../components/ImageLightbox.astro';
import ConfidenceRating from '../components/ConfidenceRating.astro';
import ImportanceRating from '../components/ImportanceRating.astro';
import { siteConfig } from '../config';
import type { Post, GrowthStatus } from '../types';
import type { GrowthMetrics } from '../utils/growth';

export interface Props {
  post: Post;
  headings?: Array<{ depth: number; slug: string; text: string }>;
  effectiveGrowth?: GrowthStatus;
  growthMetrics?: GrowthMetrics;
}

const { post, headings = [], effectiveGrowth, growthMetrics } = Astro.props;
const { title, description, growth, planted, lastTended, tags, image, imageAlt, confidence, importance } = post.data;
// Use effective growth if provided, otherwise fall back to manual growth
const displayGrowth = effectiveGrowth || growth;

// Format dates
const plantedDate = planted.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const tendedDate = lastTended?.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

// Calculate reading time (rough estimate)
const content = post.body || '';
const words = content.split(/\s+/).length;
const readingTime = Math.ceil(words / 200);
---

<BaseLayout title={title} description={description} image={image}>
  <Header slot="header" />

  <div class="max-w-5xl mx-auto px-4 py-8 sm:py-12">
    <div class="lg:grid lg:grid-cols-[1fr,280px] lg:gap-8">
      <!-- Main Content -->
      <article>
        <!-- Post Header -->
        <header class="mb-8">
          <!-- Growth indicator and dates -->
          <div class="flex flex-wrap items-center gap-4 text-sm text-primary-600 dark:text-primary-400 mb-4">
            {siteConfig.garden.showGrowthStatus && (
              <GrowthIndicator status={displayGrowth} showLabel />
            )}

            {siteConfig.garden.showPlantedDate && (
              <span class="flex items-center gap-1">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M12 2v6m0 0a4 4 0 100 8 4 4 0 000-8z"/>
                  <path d="M12 22v-6"/>
                </svg>
                Planted {plantedDate}
              </span>
            )}

            {siteConfig.garden.showLastTended && tendedDate && (
              <span class="flex items-center gap-1">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M12 8v4l3 3"/>
                  <circle cx="12" cy="12" r="10"/>
                </svg>
                Tended {tendedDate}
              </span>
            )}

            {siteConfig.posts.showReadingTime && (
              <span class="flex items-center gap-1">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/>
                  <path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/>
                </svg>
                {readingTime} min read
              </span>
            )}

            {confidence && (
              <ConfidenceRating level={confidence} />
            )}

            {importance && (
              <ImportanceRating level={importance} />
            )}
          </div>

          <!-- Title -->
          <h1 class="text-3xl sm:text-4xl font-bold text-primary-900 dark:text-primary-100 mb-4">
            {title}
          </h1>

          <!-- Description -->
          {description && (
            <p class="text-lg text-primary-600 dark:text-primary-400 mb-4">
              {description}
            </p>
          )}

          <!-- Tags -->
          {siteConfig.posts.showTags && tags && tags.length > 0 && (
            <Tags tags={tags} />
          )}
        </header>

        <!-- Cover Image -->
        {image && (
          <figure class="mb-8 -mx-4 sm:mx-0">
            <img
              src={image}
              alt={imageAlt || title}
              class="w-full rounded-lg sm:rounded-xl"
            />
          </figure>
        )}

        <!-- Post Content -->
        <div class="prose-mycelium">
          <slot />
        </div>

        <!-- Backlinks section -->
        <LinkedMentions currentSlug={post.id} />

        <!-- Comments -->
        <Giscus />
      </article>

      <!-- Sidebar -->
      <aside class="hidden lg:block">
        <div class="sticky top-24 space-y-6 max-h-[calc(100vh-8rem)] overflow-y-auto">
          <!-- Table of Contents -->
          {siteConfig.features.tableOfContents && headings.length > 0 && (
            <TableOfContents headings={headings} />
          )}

          <!-- Local Graph -->
          {siteConfig.features.localGraph && (
            <div>
              <h3 class="text-sm font-medium text-primary-600 dark:text-primary-400 mb-3">
                Connections
              </h3>
              <LocalGraph currentSlug={post.id} />
            </div>
          )}
        </div>
      </aside>
    </div>
  </div>

  <Footer slot="footer" />

  <!-- Gwern-style features -->
  {siteConfig.features.linkPreviews && <LinkPreview />}
  {siteConfig.features.imageLightbox && <ImageLightbox />}
</BaseLayout>

<!-- Twitter Widget Script for embedded tweets -->
<script>
  // Load Twitter widget script if there are tweet embeds
  document.addEventListener('DOMContentLoaded', () => {
    const tweetEmbeds = document.querySelectorAll('.twitter-embed');
    if (tweetEmbeds.length > 0) {
      const script = document.createElement('script');
      script.src = 'https://platform.twitter.com/widgets.js';
      script.async = true;
      script.charset = 'utf-8';
      document.body.appendChild(script);
    }
  });
</script>

<!-- Mermaid diagram rendering -->
<script>
  document.addEventListener('DOMContentLoaded', async () => {
    const mermaidContainers = document.querySelectorAll('.mermaid');
    if (mermaidContainers.length > 0) {
      // @ts-ignore - Dynamic import
      const mermaid = await import('https://cdn.jsdelivr.net/npm/mermaid@10/dist/mermaid.esm.min.mjs');

      // Configure mermaid
      mermaid.default.initialize({
        startOnLoad: false,
        theme: document.documentElement.classList.contains('dark') ? 'dark' : 'default',
        securityLevel: 'loose',
        fontFamily: 'inherit',
      });

      // Render all mermaid diagrams
      mermaid.default.run({
        nodes: mermaidContainers,
      });

      // Re-render on theme change
      window.addEventListener('themechange', (e: CustomEvent) => {
        mermaid.default.initialize({
          startOnLoad: false,
          theme: e.detail.dark ? 'dark' : 'default',
          securityLevel: 'loose',
          fontFamily: 'inherit',
        });

        // Need to reset and re-render
        mermaidContainers.forEach((container) => {
          const svg = container.querySelector('svg');
          if (svg) {
            const original = container.getAttribute('data-original');
            if (original) {
              container.innerHTML = original;
            }
          }
        });

        mermaid.default.run({
          nodes: mermaidContainers,
        });
      });

      // Store original content for re-rendering
      mermaidContainers.forEach((container) => {
        container.setAttribute('data-original', container.innerHTML);
      });
    }
  });
</script>

<!-- Image gallery lightbox -->
<script>
  function initGalleries() {
    const galleries = document.querySelectorAll('[data-gallery]');

    galleries.forEach((gallery) => {
      const thumbnails = gallery.querySelectorAll('.gallery-thumbnail');
      const lightbox = gallery.querySelector('[data-lightbox]') as HTMLElement;
      if (!lightbox) return;

      const lightboxImage = gallery.querySelector('[data-lightbox-image]') as HTMLImageElement;
      const lightboxCaption = gallery.querySelector('[data-lightbox-caption]') as HTMLElement;
      const lightboxCounter = gallery.querySelector('[data-lightbox-counter]') as HTMLElement;
      const closeBtn = gallery.querySelector('[data-lightbox-close]');
      const prevBtn = gallery.querySelector('[data-lightbox-prev]');
      const nextBtn = gallery.querySelector('[data-lightbox-next]');

      let currentIndex = 0;
      const totalImages = thumbnails.length;

      function showImage(index: number) {
        currentIndex = (index + totalImages) % totalImages;
        const thumb = thumbnails[currentIndex] as HTMLElement;

        lightboxImage.src = thumb.dataset.src || '';
        lightboxImage.alt = thumb.dataset.alt || '';

        const caption = thumb.dataset.caption;
        if (caption) {
          lightboxCaption.textContent = caption;
          lightboxCaption.classList.remove('hidden');
        } else {
          lightboxCaption.classList.add('hidden');
        }

        if (lightboxCounter) {
          lightboxCounter.textContent = `${currentIndex + 1} / ${totalImages}`;
        }
      }

      function openLightbox(index: number) {
        showImage(index);
        lightbox.classList.remove('hidden');
        lightbox.classList.add('flex');
        document.body.style.overflow = 'hidden';
      }

      function closeLightbox() {
        lightbox.classList.add('hidden');
        lightbox.classList.remove('flex');
        document.body.style.overflow = '';
      }

      thumbnails.forEach((thumb) => {
        thumb.addEventListener('click', () => {
          const index = parseInt((thumb as HTMLElement).dataset.index || '0');
          openLightbox(index);
        });
      });

      closeBtn?.addEventListener('click', closeLightbox);

      lightbox.addEventListener('click', (e) => {
        if (e.target === lightbox) closeLightbox();
      });

      prevBtn?.addEventListener('click', (e) => {
        e.stopPropagation();
        showImage(currentIndex - 1);
      });

      nextBtn?.addEventListener('click', (e) => {
        e.stopPropagation();
        showImage(currentIndex + 1);
      });

      const handleKeydown = (e: KeyboardEvent) => {
        if (!lightbox.classList.contains('flex')) return;
        if (e.key === 'Escape') closeLightbox();
        if (e.key === 'ArrowLeft') showImage(currentIndex - 1);
        if (e.key === 'ArrowRight') showImage(currentIndex + 1);
      };

      document.addEventListener('keydown', handleKeydown);
    });
  }

  document.addEventListener('DOMContentLoaded', initGalleries);
  document.addEventListener('astro:page-load', initGalleries);
</script>

<!-- External links open in new tab -->
<script>
  function initExternalLinks() {
    const proseLinks = document.querySelectorAll('.prose-mycelium a[href^="http"]');
    proseLinks.forEach(link => {
      const href = link.getAttribute('href');
      // Skip localhost links
      if (href?.includes('localhost')) return;
      // Add target and rel attributes
      link.setAttribute('target', '_blank');
      link.setAttribute('rel', 'noopener noreferrer');
    });
  }
  document.addEventListener('DOMContentLoaded', initExternalLinks);
  document.addEventListener('astro:page-load', initExternalLinks);
</script>
